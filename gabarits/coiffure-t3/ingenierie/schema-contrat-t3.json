{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "template_id",
    "statut",
    "implementation",
    "capture",
    "sortie",
    "texte",
    "audio",
    "limites"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "template_id": {
      "const": "COIFFURE-T3"
    },
    "statut": {
      "const": "revision_navigateur"
    },
    "capture": {
      "type": "object",
      "properties": {
        "nombre_scenes": {
          "const": 4
        },
        "nombre_etats_stables": {
          "const": 12
        },
        "ordre": {
          "const": [
            "S1",
            "S2",
            "S3",
            "S4"
          ]
        },
        "maximum_total_images": {
          "const": 899
        }
      }
    },
    "sortie": {
      "type": "object",
      "properties": {
        "largeur_px": {
          "const": 720
        },
        "hauteur_px": {
          "const": 1280
        },
        "fps": {
          "const": 30
        },
        "images_max": {
          "const": 899
        },
        "duree_max_s": {
          "const": 30
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "reconnaissance_de_fin_de_phrase": {
          "const": false
        },
        "garantie_fin_phrase": {
          "const": false
        },
        "transcription_automatique": {
          "const": false
        }
      }
    }
  }
}
