      "properties": {
        "facultative_et_sur_consentement": {
          "const": true
        },
        "persistance_garantie": {
          "const": false
        }
      }
    },
    "render_protocol": {
      "type": "object",
      "required": [
        "status",
        "steps",
        "retry",
        "errors",
        "result"
      ]
    },
    "compatibility": {
      "type": "object",
      "required": [
        "friend_template",
        "direct_interchangeability_tested",
        "observed_partner_schema_result",
        "partner_engine_acceptance_tested",
        "next_step"
      ],
      "properties": {
        "direct_interchangeability_tested": {
          "const": false
        },
        "partner_engine_acceptance_tested": {
          "const": false
        }
      }
    }
