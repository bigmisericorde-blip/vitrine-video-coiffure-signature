{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Description technique handoff T4, distincte de T1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "template_id",
    "status",
    "usage",
    "implementation_handoff",
    "media_ingest_contract",
    "speech_continuity",
    "execution_contract",
    "recovery",
    "render_protocol",
    "compatibility"
  ],
  "properties": {
    "$schema": {
      "const": "handoff-t4.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "template_id": {
      "const": "BEAUTE-T4"
    },
    "status": {
      "const": "description_technique_t4"
    },
    "usage": {
      "type": "string",
      "minLength": 1
    },
    "implementation_handoff": {
      "type": "object",
      "required": [
        "contract_type",
        "runtime_order",
        "counts",
        "states",
        "screens",
        "merchant_bindings",
        "renderer_handoff"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "properties": {
            "merchant_questions": {
              "const": 8
            },
            "capture_scenes": {
              "const": 4
            },
            "stable_capture_screens": {
              "const": 12
            },
            "capture_states_per_scene": {
              "const": 3
            },
            "output_video_files": {
              "const": 1
            }
