          "required": [
            "merchant_questions",
            "capture_scenes",
            "stable_capture_screens",
            "capture_states_per_scene",
            "output_video_files"
          ]
        },
        "screens": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "ordinal",
              "screen_id",
              "scene_id",
              "state",
              "role"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "scene_id": {
                "enum": [
                  "S1",
                  "S2",
                  "S3",
                  "S4"
                ]
              },
              "state": {
                "enum": [
                  "A_GUIDE",
                  "B_ENREGISTREMENT_OU_LECTURE_IMPORT",
                  "C_RELECTURE"
                ]
              },
              "screen_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          },
          "prefixItems": [
            {
              "properties": {
                "ordinal": {
                  "const": 1
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S1_A_GUIDE"
                },
                "scene_id": {
                  "const": "S1"
                },
                "state": {
                  "const": "A_GUIDE"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 2
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S1_B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                },
                "scene_id": {
                  "const": "S1"
                },
                "state": {
                  "const": "B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 3
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S1_C_RELECTURE"
                },
                "scene_id": {
                  "const": "S1"
                },
                "state": {
                  "const": "C_RELECTURE"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 4
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S2_A_GUIDE"
                },
                "scene_id": {
                  "const": "S2"
                },
                "state": {
                  "const": "A_GUIDE"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 5
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S2_B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                },
                "scene_id": {
                  "const": "S2"
                },
                "state": {
                  "const": "B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 6
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S2_C_RELECTURE"
                },
                "scene_id": {
                  "const": "S2"
                },
                "state": {
                  "const": "C_RELECTURE"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 7
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S3_A_GUIDE"
                },
                "scene_id": {
                  "const": "S3"
                },
                "state": {
                  "const": "A_GUIDE"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 8
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S3_B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                },
                "scene_id": {
                  "const": "S3"
                },
                "state": {
                  "const": "B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 9
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S3_C_RELECTURE"
                },
                "scene_id": {
                  "const": "S3"
                },
                "state": {
                  "const": "C_RELECTURE"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 10
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S4_A_GUIDE"
                },
                "scene_id": {
                  "const": "S4"
                },
                "state": {
                  "const": "A_GUIDE"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 11
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S4_B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                },
                "scene_id": {
                  "const": "S4"
                },
                "state": {
                  "const": "B_ENREGISTREMENT_OU_LECTURE_IMPORT"
                }
              }
            },
            {
              "properties": {
                "ordinal": {
                  "const": 12
                },
                "screen_id": {
                  "const": "T4_CAPTURE_S4_C_RELECTURE"
                },
                "scene_id": {
                  "const": "S4"
                },
                "state": {
                  "const": "C_RELECTURE"
                }
              }
            }
          ],
          "uniqueItems": true
        },
        "merchant_bindings": {
          "type": "object",
          "required": [
            "required",
            "optional",
            "guidance_only",
            "consent_fields"
          ]
        },
        "renderer_handoff": {
          "type": "object"
        }
      }
    },
    "media_ingest_contract": {
      "type": "object",
      "required": [
        "containers",
        "decode",
        "normalization",
        "fps_source",
        "audio_required",
        "max_bytes_per_take",
        "face_lip_sync_protection_automatic"
      ],
      "properties": {
        "audio_required": {
          "const": false
        },
        "face_lip_sync_protection_automatic": {
          "const": false
        }
      }
    },
    "speech_continuity": {
      "type": "object",
      "required": [
        "audio_source",
        "time_map",
        "internal_visual_effects",
        "tail_detector"
      ]
    },
    "execution_contract": {
      "type": "object",
      "required": [
        "runtime",
        "remote_render_server_required",
        "offline_guaranteed",
        "network_note",
        "android_media3_backend",
        "minimum_ram_guaranteed"
      ],
      "properties": {
        "remote_render_server_required": {
          "const": false
        },
        "offline_guaranteed": {
          "const": false
        },
        "android_media3_backend": {
          "const": false
        }
      }
