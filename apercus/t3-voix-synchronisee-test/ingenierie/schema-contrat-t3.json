{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrat descriptif T3 navigateur",
  "type": "object",
  "required": [
    "schema_version",
    "template_id",
    "statut",
    "implementation",
    "sortie",
    "champs",
    "capture",
    "montage",
    "audio",
    "texte",
    "verification"
  ],
  "properties": {
    "template_id": {
      "const": "COIFFURE-T3"
    },
    "sortie": {
      "type": "object",
      "required": [
        "largeur_px",
        "hauteur_px",
        "fps",
        "images",
        "duree_s"
      ],
      "properties": {
        "largeur_px": {
          "const": 720
        },
        "hauteur_px": {
          "const": 1280
        },
        "fps": {
          "const": 30
        },
        "images": {
          "const": 900
        },
        "duree_s": {
          "const": 30
        }
      }
    },
    "champs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "libelle",
          "obligatoire",
          "maximum_caracteres",
          "usage"
        ]
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "nombre_scenes",
        "nombre_etats_stables",
        "scenes"
      ],
      "properties": {
        "nombre_scenes": {
          "const": 4
        },
        "nombre_etats_stables": {
          "const": 12
        },
        "scenes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "titre",
              "minimum_s",
              "etats"
            ],
            "properties": {
              "etats": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      }
    },
    "montage": {
      "type": "object",
      "required": [
        "semantique",
        "nombre_segments",
        "segments",
        "variante_voix_prises"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "debut",
              "fin_exclue",
              "sources"
            ],
            "properties": {
              "debut": {
                "type": "integer",
                "minimum": 0
              },
              "fin_exclue": {
                "type": "integer",
                "maximum": 900
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "offset_images",
                    "progression_images_par_image"
                  ]
                }
              }
            }
          }
        },
        "variante_voix_prises": {
          "type": "object",
          "required": [
            "semantique",
            "segments",
            "coupes"
          ],
          "properties": {
            "coupes": {
              "const": [
                180,
                420,
                660
              ]
            },
            "segments": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "debut",
                  "fin_exclue",
                  "source",
                  "source_debut",
                  "source_fin_exclue",
                  "vitesse"
                ],
                "properties": {
                  "source": {
                    "enum": [
                      "S1",
                      "S2",
                      "S3",
                      "S4"
                    ]
                  },
                  "vitesse": {
                    "const": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "voix_facultative": {
          "const": true
        },
        "sous_titres_automatiques": {
          "const": false
        }
      }
    },
    "texte": {
      "type": "object",
      "properties": {
        "ajoute_par_moteur": {
          "const": false
        }
      }
    }
  }
}
