{
  "$schema": "../schemas/t1-beaute.schema.json",
  "schema": "vv.beaute.t1.runtime/1",
  "template_id": "T1_BEAUTE",
  "version": "1.0.0",
  "technical_renderer_id": "T2",
  "language": "fr",
  "purpose": "Contrat T1 beauté : cinq questions, quatre prises, douze états, une vidéo ; usage beauté général, coiffure en exemple.",
  "merchant_input": {
    "fields": [
      {
        "id": "salon",
        "question": "Quel est le nom de ton salon ou de ton activité ?",
        "required": true,
        "max_length": 45,
        "example": "Studio Vitrine",
        "hint": "",
        "type": "text",
        "render_targets": [
          "ouverture.nom",
          "fin.nom"
        ]
      },
      {
        "id": "service",
        "question": "Quelle prestation veux-tu présenter dans ta vidéo ?",
        "required": true,
        "max_length": 50,
        "example": "Ex. Coupe homme",
        "hint": "Par exemple : tresses africaines, maquillage ou coupe homme.",
        "type": "text",
        "render_targets": [
          "ouverture.prestation",
          "offre.prestation",
          "geste.prestation",
          "detail.prestation",
          "resultat.prestation",
          "fin.prestation"
        ]
      },
      {
        "id": "ville",
        "question": "Dans quelle ville se trouve ton salon ?",
        "required": false,
        "max_length": 45,
        "example": "Cotonou",
        "hint": "Facultatif.",
        "type": "text",
        "render_targets": [
          "ouverture.ville",
          "offre.ville",
          "fin.ville"
        ]
      },
      {
        "id": "contact",
        "question": "Quel est ton numéro WhatsApp ou téléphone ?",
        "required": false,
        "max_length": 30,
        "example": "+229 XX XX XX XX",
        "hint": "Facultatif. Indique seulement un numéro que les clients peuvent voir.",
        "type": "tel",
        "render_targets": [
          "contact.numero",
          "fin.numero"
        ]
      },
      {
        "id": "prix",
        "question": "À partir de quel prix proposes-tu cette prestation ?",
        "required": false,
        "max_length": 40,
        "example": "À partir de 2 500 FCFA",
        "hint": "Facultatif. Laisse vide si tu ne veux pas afficher de prix ; « À partir de » sera ajouté si besoin.",
        "type": "text",
        "render_targets": [
          "offre.prix",
          "fin.prix"
        ]
      }
    ],
    "optional_empty": "Ne pas afficher de valeur vide ou inventée.",
    "phone_policy": "Numéro publié seulement si fourni ; ne pas supposer WhatsApp ou appel.",
    "price_policy": "Préfixer À partir de si nécessaire ; ne pas inventer un prix."
  },
